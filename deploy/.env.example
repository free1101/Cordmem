# =============================================================================
# 部署环境变量文档（deploy/.env.example）
#
# 这是启动 aml-memory 服务**必须在 .env 里填**的变量清单。
# 复制本文件为同目录下的 .env（compose 用 `env_file: deploy/.env` 挂载），
# 把每行的 `改成...` 换成真实值即可。
#
# 优先级铁律（见 src/config.py 头部）：YAML > 环境变量。
#   deploy/config.server.yaml 已经显式声明了所有检索参数，
#   所以**不要在 .env 里重复设置 MEMORY_* / EMBEDDING_* 字段**——
#   重复设置只会被忽略并打 WARNING。本文件只放两类变量：
#     (A) 非 ServerConfig 的密钥/路径：AML_API_KEY / DASHSCOPE_API_KEY /
#         MEMORY_CONFIG / MEMORY_DB_PATH
#     (B) 仅本地/冒烟放行用的 ALLOW_UNAUTHENTICATED（公网绝不设）
#
# 完整的 ServerConfig 可调环境变量（MEMORY_* / EMBEDDING_*）请查：
#   doc/参数字典.md  —— 但注意只在 config.server.yaml 没声明该字段时才生效。
# =============================================================================


# -----------------------------------------------------------------------------
# (A) 平台鉴权 —— 必填，否则 /add /search 一律返回 503
# -----------------------------------------------------------------------------
# 你给 AML 平台配置的那个 Leaderboard API Key（Authorization: Bearer / X-Api-Key）。
# 自己起一个长随机串即可；平台调用时会带上它。
# 平台支持三种头：Authorization: Bearer <key> /  Authorization: Token <key> /
#                X-Api-Key: <key>，app.py 的 _extract_api_key 都认。
AML_API_KEY=改成你的长随机串_例如_aml_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Embedding 密钥（阿里百炼 text-embedding-v4，学术榜硬性要求）。
# ⚠ 缺失时 MemoryStore 构造期的 _check_identity() 会直接抛 RuntimeError，
#   容器起不来。key 与地域绑定：北京/新加坡的 key 不能混用。
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# -----------------------------------------------------------------------------
# 服务配置（非 ServerConfig，但与 config.server.yaml 互补）
# -----------------------------------------------------------------------------
# YAML 配置入口；与 config.server.yaml 保持一致即可，一般不用改。
MEMORY_CONFIG=/app/config.server.yaml
# SQLite 库路径；对应 compose 里挂的 volume（/data）。改路径 = 换新库。
MEMORY_DB_PATH=/data/memories.db


# -----------------------------------------------------------------------------
# (B) 本地/冒烟放行 —— 公网部署**绝不能**设此项
# -----------------------------------------------------------------------------
# 默认（不设）: 没带正确 AML_API_KEY 的请求 -> 503。
# 本地跑 smoke_test.py / verify.py 时它们自己会 setdefault("ALLOW_UNAUTHENTICATED","true")，
# 所以本地无需在此设置。云服务器上**务必删掉或保持注释**，否则等于裸奔。
# ALLOW_UNAUTHENTICATED=true


# -----------------------------------------------------------------------------
# 以下均为【可选】，且均已在 config.server.yaml 声明 -> 此处重复设置会被忽略。
# 仅当你想临时用环境变量覆盖某个检索参数时才在此加；例如：
#   MEMORY_MMR_ENABLED=true      # 仅当 config.server.yaml 没写这一项才生效
# 完整可写的环境变量名见 doc/参数字典.md。
# -----------------------------------------------------------------------------
